DATABASE_URL=postgres://triage:triage@localhost:5432/triage
REDIS_URL=redis://localhost:6379
PORT=3000

# Object storage (RustFS from docker-compose; on AWS leave the endpoint and keys unset)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=incident-attachments
S3_ACCESS_KEY_ID=triage
S3_SECRET_ACCESS_KEY=triage-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
UPLOAD_PART_SIZE_MB=8
UPLOAD_MAX_SIZE_MB=10240
UPLOAD_PRESIGN_TTL_SECONDS=900
